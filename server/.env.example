# ═══════════════════════════════════════════════
#  MathViz Server — 环境变量配置
#  复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════════════

PORT=3001
NODE_ENV=development

# Supabase (service_role key — 后端使用，权限最高)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT 签名密钥（请使用 openssl rand -hex 32 生成）
JWT_SECRET=your-256-bit-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# DeepSeek AI API（解题推理）
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ── 识图 OCR（任选一种，国内推荐智谱或通义）──────────
# 方式 A：智谱 GLM-4V（常有免费额度）https://open.bigmodel.cn/
VISION_PROVIDER=zhipu
VISION_API_KEY=
# 方式 B：通义千问 VL https://dashscope.console.aliyun.com/
# VISION_PROVIDER=qwen
# VISION_API_KEY=
# 方式 C：硅基流动 https://cloud.siliconflow.cn/
# VISION_PROVIDER=siliconflow
# VISION_API_KEY=
# 方式 D：OpenAI
# VISION_PROVIDER=openai
# VISION_API_KEY=
# 方式 E：自定义 OpenAI 兼容接口
# VISION_API_BASE=https://your-endpoint/v1
# VISION_API_MODEL=your-vl-model
# VISION_API_KEY=
# 可选 Gemini
# GEMINI_API_KEY=

# Stripe 支付
# 测试密钥: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 前端地址 (CORS 白名单)
FRONTEND_URL=http://localhost:5179
